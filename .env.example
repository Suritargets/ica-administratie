# Neon (Vercel → Storage → Neon zet deze automatisch)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Lange willekeurige tekst (min. 32 tekens) om sessies te ondertekenen: openssl rand -hex 32
SESSION_SECRET=
# Alleen nodig voor `npm run db:setup`: het eerste admin-account
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Beheerder
